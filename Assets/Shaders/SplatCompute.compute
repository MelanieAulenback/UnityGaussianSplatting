[numthreads(256, 1, 1)]
void ColourGaussians(uint id : SV_DispatchThreadID)
{
    if (id >= _GaussianCount)
        return;


    // -------------------------------------------------
    // Diagnostic: total positions entering kernel
    // -------------------------------------------------

    InterlockedAdd(_ColourDiagnostic[0], 1);


    float3 worldPos = _Positions[id];


    // -------------------------------------------------
    // Camera-space depth
    // -------------------------------------------------

    float4 camPos = mul(
        _WorldToCamera,
        float4(worldPos, 1)
    );

    float gaussianDepth = -camPos.z;


    if (gaussianDepth <= 0)
        return;


    InterlockedAdd(_ColourDiagnostic[1], 1);


    // -------------------------------------------------
    // Project Gaussian
    // -------------------------------------------------

    float4 clip = mul(
        _ViewProj,
        float4(worldPos, 1)
    );


    if (clip.w <= 0)
        return;


    float2 ndc = clip.xy / clip.w;


    float2 uv;

    uv.x = 1.0 - (ndc.x * 0.5 + 0.5);
    uv.y = 1.0 - (ndc.y * 0.5 + 0.5);


    if (
        uv.x < 0 ||
        uv.x > 1 ||
        uv.y < 0 ||
        uv.y > 1
    )
    {
        return;
    }


    InterlockedAdd(
        _ColourDiagnostic[2],
        1
    );


    // -------------------------------------------------
    // Depth texture pixel
    // -------------------------------------------------

    uint2 pixel;

    pixel.x =
        (uint) (uv.x * TextureWidth);

    pixel.y =
        (uint) (uv.y * TextureHeight);


    pixel.x =
        min(
            pixel.x,
            TextureWidth - 1
        );

    pixel.y =
        min(
            pixel.y,
            TextureHeight - 1
        );


    // -------------------------------------------------
    // Colour texture pixel
    // -------------------------------------------------

    uint2 colorPixel;

    colorPixel.x =
        (uint) (uv.x * ColorTextureWidth);

    colorPixel.y =
        (uint) ((1.0 - uv.y) * ColorTextureHeight);


    colorPixel.x =
        min(
            colorPixel.x,
            ColorTextureWidth - 1
        );

    colorPixel.y =
        min(
            colorPixel.y,
            ColorTextureHeight - 1
        );


    // -------------------------------------------------
    // PERSON / COLOUR MASK TEST
    //
    // The projected Gaussian must land directly
    // on a foreground pixel.
    // -------------------------------------------------

    float4 color =
        _ColorTex.Load(
            int3(colorPixel, 0)
        );


    // Alpha <= 0 means background.
    if (color.a <= 0.0)
    {
        return;
    }


    InterlockedAdd(
        _ColourDiagnostic[3],
        1
    );


    // -------------------------------------------------
    // Find depth around projected point
    // -------------------------------------------------

    // -------------------------------------------------
    // Get depth at the exact projected Gaussian pixel
    // -------------------------------------------------

    float depthFromMap =
    _DepthTex.Load(
        int3(pixel, 0)
    );

    // No valid depth
    if (
        depthFromMap <= 0.001 ||
        depthFromMap >= 9990.0
    )
    {
        return;
    }


    InterlockedAdd(
        _ColourDiagnostic[4],
        1
    );


    // -------------------------------------------------
    // Depth consistency
    // -------------------------------------------------

    const float frontTolerance = 0.01;
    const float backTolerance = 0.03;


    float delta =
        gaussianDepth - depthFromMap;


    // Positive delta:
    // Gaussian is behind the depth surface.
    //
    // Negative delta:
    // Gaussian is in front of the depth surface.

    if (
        delta < -frontTolerance ||
        delta > backTolerance
    )
    {
        return;
    }


    InterlockedAdd(
        _ColourDiagnostic[5],
        1
    );


    // -------------------------------------------------
    // Camera quality score
    // -------------------------------------------------

    float depthError =
        abs(delta);


    float2 centred =
        uv * 2.0 - 1.0;


    float radial =
        length(centred);


    float border =
        min(
            min(uv.x, uv.y),
            min(1.0 - uv.x, 1.0 - uv.y)
        );


    float score =
        depthError * 150.0
        + radial * 3.0
        + (1.0 - border) * 2.0;


    // -------------------------------------------------
    // Diagnostic: reached final stage
    // -------------------------------------------------

    InterlockedAdd(
        _ColourDiagnostic[6],
        1
    );


    // -------------------------------------------------
    // Keep best camera
    // -------------------------------------------------

    if (
        score <
        _BestCameraScore[id] - 0.1
    )
    {
        _BestCameraScore[id] = score;

        _AccumColor[id] = color;

        _Contribution[id] = 1;
    }
}



[numthreads(256, 1, 1)]
void FinalizeColours(uint id : SV_DispatchThreadID)
{
    if (id >= _GaussianCount)
        return;


    uint count = _Contribution[id];


    if (count == 0)
    {
        _FinalColor[id] = float4(0, 0, 0, 0);
        return;
    }
    
    float4 color = _AccumColor[id] / count;

    // Keep the accumulated alpha.
    _FinalColor[id] = color;
}

[numthreads(64, 1, 1)]
void WriteDepth(uint id : SV_DispatchThreadID)
{
    if (id >= _GaussianCount)
        return;


    float3 worldPos = _Positions[id];


    // ------------------------------------------
    // Camera-space depth
    // ------------------------------------------

    float4 camPos = mul(
        _WorldToCamera,
        float4(worldPos, 1)
    );

    float depth = -camPos.z;

    if (depth <= 0)
        return;


    // ------------------------------------------
    // Project Gaussian
    // ------------------------------------------

    float4 clipPos = mul(
        _ViewProj,
        float4(worldPos, 1)
    );

    if (clipPos.w <= 0)
        return;


    float2 ndc =
        clipPos.xy / clipPos.w;


    float2 uv;

    uv.x =
        1.0 -
        (ndc.x * 0.5 + 0.5);

    uv.y =
        1.0 -
        (ndc.y * 0.5 + 0.5);


    if (
        uv.x < 0 ||
        uv.x > 1 ||
        uv.y < 0 ||
        uv.y > 1
    )
    {
        return;
    }


    // ------------------------------------------
    // Convert to depth pixel
    // ------------------------------------------

    uint2 pixel;

    pixel.x =
        (uint) (uv.x * TextureWidth);

    pixel.y =
        (uint) (uv.y * TextureHeight);


    if (
        pixel.x >= TextureWidth ||
        pixel.y >= TextureHeight
    )
    {
        return;
    }


    // ------------------------------------------
    // Depth value
    // ------------------------------------------

    int depthInt =
        (int) (depth * 1000.0);


    // ------------------------------------------
    // Write depth footprint
    // ------------------------------------------

    const int radius = 5;


    for (
        int y = -radius;
        y <= radius;
        y++
    )
    {
        for (
            int x = -radius;
            x <= radius;
            x++
        )
        {
            if (
                x * x +
                y * y >
                radius * radius
            )
            {
                continue;
            }


            int2 p =
                int2(pixel) +
                int2(x, y);


            if (
                p.x < 0 ||
                p.y < 0 ||
                p.x >= TextureWidth ||
                p.y >= TextureHeight
            )
            {
                continue;
            }


            // ----------------------------------
            // Convert depth pixel back into
            // colour-image coordinates
            // ----------------------------------

            float2 depthUV;

            depthUV.x =
                (p.x + 0.5) /
                (float) TextureWidth;

            depthUV.y =
                (p.y + 0.5) /
                (float) TextureHeight;


            uint2 maskPixel;

            maskPixel.x =
                (uint) (
                    depthUV.x *
                    ColorTextureWidth
                );

            maskPixel.y =
                (uint) (
                    (1.0 - depthUV.y) *
                    ColorTextureHeight
                );


            maskPixel.x =
                min(
                    maskPixel.x,
                    ColorTextureWidth - 1
                );

            maskPixel.y =
                min(
                    maskPixel.y,
                    ColorTextureHeight - 1
                );


            // ----------------------------------
            // ONLY write depth if this pixel
            // is actually inside the colour mask
            // ----------------------------------

            float4 maskColor =
                _ColorTex.Load(
                    int3(maskPixel, 0)
                );


            if (maskColor.a <= 0.0)
            {
                continue;
            }


            // ----------------------------------
            // Write depth
            // ----------------------------------

            int oldDepth;

            InterlockedMin(
                DepthTexture[p],
                depthInt,
                oldDepth
            );
        }
    }
}

[numthreads(8, 8, 1)]
void ConvertDepth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= TextureWidth ||
       id.y >= TextureHeight)
        return;


    int d = DepthIntTexture[id.xy];

    if (d == 2147483647)
    {
        DepthFloatTexture[id.xy] = 9999;
    }
    else
    {
        DepthFloatTexture[id.xy] = d / 1000.0;
    }
}

[numthreads(8, 8, 1)]
void ClearDepth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= TextureWidth ||
       id.y >= TextureHeight)
        return;

    DepthTexture[id.xy] = 2147483647;
}

[numthreads(64, 1, 1)]
void WriteCombinedDepth(uint id : SV_DispatchThreadID)
{
    if (id >= _CombinedGaussianCount)
        return;

    // ------------------------------------------
    // Ignore transparent Gaussians
    // ------------------------------------------

    float4 color = _CombinedColors[id];

    if (color.a <= 0.0)
        return;


    float3 localPos =
        _CombinedPositions[id];

    float3 worldPos =
        mul(
            _CombinedLocalToWorld,
            float4(localPos, 1.0)
        ).xyz;

    float4 camPos =
        mul(
            _CombinedWorldToCamera,
            float4(worldPos, 1.0)
        );

    float depth = -camPos.z;

    if (depth <= 0)
        return;


    // ------------------------------------------
    // Project into player's camera
    // ------------------------------------------

    float4 clipPos = mul(
        _CombinedViewProj,
        float4(worldPos, 1)
    );

    if (clipPos.w <= 0)
        return;


    float2 ndc =
        clipPos.xy / clipPos.w;


    float2 uv;

    uv.x =
        1.0 -
        (ndc.x * 0.5 + 0.5);

    uv.y =
        1.0 -
        (ndc.y * 0.5 + 0.5);


    if (
        uv.x < 0 ||
        uv.x > 1 ||
        uv.y < 0 ||
        uv.y > 1
    )
    {
        return;
    }


    // ------------------------------------------
    // Convert to depth pixel
    // ------------------------------------------

    uint2 pixel;

    pixel.x =
        (uint) (uv.x * _CombinedTextureWidth);

    pixel.y =
        (uint) (uv.y * _CombinedTextureHeight);


    if (
        pixel.x >= _CombinedTextureWidth ||
        pixel.y >= _CombinedTextureHeight
    )
    {
        return;
    }


    // ------------------------------------------
    // Depth in millimetres
    // ------------------------------------------

    int depthInt =
        (int) (depth * 1000.0);


    // ------------------------------------------
    // Write closest depth
    // ------------------------------------------

    const int radius = 5;

    for (int y = -radius; y <= radius; y++)
    {
        for (int x = -radius; x <= radius; x++)
        {
            if (
            x * x +
            y * y >
            radius * radius
        )
                continue;

            int2 p =
            int2(pixel) +
            int2(x, y);

            if (
            p.x < 0 ||
            p.y < 0 ||
            p.x >= _CombinedTextureWidth ||
            p.y >= _CombinedTextureHeight
        )
                continue;

            InterlockedMin(
            CombinedDepthTexture[p],
            depthInt
        );
        }
    }
}

[numthreads(8, 8, 1)]
void ClearCombinedDepth(uint3 id : SV_DispatchThreadID)
{
    if (
        id.x >= _CombinedTextureWidth ||
        id.y >= _CombinedTextureHeight
    )
        return;

    CombinedDepthTexture[id.xy] = 2147483647;
}

[numthreads(8, 8, 1)]
void ConvertCombinedDepth(uint3 id : SV_DispatchThreadID)
{
    if (
        id.x >= _CombinedTextureWidth ||
        id.y >= _CombinedTextureHeight
    )
        return;

    int depth =
        CombinedDepthIntTexture[id.xy];

    if (depth == 2147483647)
    {
        CombinedDepthFloatTexture[id.xy] = 9999.0;
    }
    else
    {
        CombinedDepthFloatTexture[id.xy] =
            depth / 1000.0;
    }
}

[numthreads(256, 1, 1)]
void FilterPositionsByMasks(uint id : SV_DispatchThreadID)
{
    if (id >= _FilterPointCount)
        return;


    float3 position = _FilterPositions[id];


    // -------------------------------------------------
    // Number of cameras where the point is visible
    // -------------------------------------------------

    uint projectedCameras = 0;

    // Number of cameras whose foreground mask
    // contains this point.
    uint foregroundVotes = 0;


    // -------------------------------------------------
    // Check every camera
    // -------------------------------------------------

    for (uint cam = 0; cam < _FilterCameraCount; cam++)
    {
        float4 worldPoint =
            float4(position, 1.0);


        // -------------------------------------------------
        // Project point
        // -------------------------------------------------

        float4 clip =
            mul(
                _FilterViewProjs[cam],
                worldPoint
            );


        if (clip.w <= 0.0)
            continue;


        float2 ndc =
            clip.xy / clip.w;


        float2 uv;

        uv.x =
            1.0 -
            (ndc.x * 0.5 + 0.5);

        uv.y =
            1.0 -
            (ndc.y * 0.5 + 0.5);


        // Outside camera
        if (
            uv.x < 0.0 ||
            uv.x > 1.0 ||
            uv.y < 0.0 ||
            uv.y > 1.0
        )
        {
            continue;
        }


        projectedCameras++;


        // -------------------------------------------------
        // Convert to mask pixel
        // -------------------------------------------------

        uint2 pixel;

        pixel.x =
            (uint) (uv.x * _FilterMaskWidth);

        pixel.y =
            (uint) ((1.0 - uv.y) * _FilterMaskHeight);


        pixel.x =
            min(
                pixel.x,
                _FilterMaskWidth - 1
            );

        pixel.y =
            min(
                pixel.y,
                _FilterMaskHeight - 1
            );


        // -------------------------------------------------
        // Search mask neighbourhood
        // -------------------------------------------------

        bool foreground = false;


        for (
            int my = -(int) _FilterMaskRadius;
            my <= (int) _FilterMaskRadius && !foreground;
            my++
        )
        {
            for (
                int mx = -(int) _FilterMaskRadius;
                mx <= (int) _FilterMaskRadius;
                mx++
            )
            {
                int2 p =
                    int2(pixel) +
                    int2(mx, my);


                if (
                    p.x < 0 ||
                    p.x >= (int) _FilterMaskWidth ||
                    p.y < 0 ||
                    p.y >= (int) _FilterMaskHeight
                )
                {
                    continue;
                }


                float4 mask =
                    _FilterMaskTex.Load(
                        int4(
                            p.x,
                            p.y,
                            cam,
                            0
                        )
                    );


                if (mask.a > 0.5)
                {
                    foreground = true;
                    break;
                }
            }
        }


        if (foreground)
        {
            foregroundVotes++;
        }
    }


    // -------------------------------------------------
    // Point wasn't visible in any camera
    // -------------------------------------------------

    if (projectedCameras == 0)
    {
        _FilterVisibility[id] = 0;
        return;
    }


    // -------------------------------------------------
    // Camera agreement
    //
    // If only one camera can see the point:
    //     require 1 vote.
    //
    // If two or more cameras can see it:
    //     require at least 2 cameras to agree.
    // -------------------------------------------------

    uint requiredVotes = _FilterRequiredVotes;

    // -------------------------------------------------
    // Final decision
    // -------------------------------------------------

    if (foregroundVotes >= requiredVotes)
    {
        _FilterVisibility[id] = 1;
    }
    else
    {
        _FilterVisibility[id] = 0;
    }
}