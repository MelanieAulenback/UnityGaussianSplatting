#pragma kernel ColourGaussians
#pragma kernel FinalizeColours
#pragma kernel WriteDepth
#pragma kernel ConvertDepth
#pragma kernel ClearDepth
#pragma kernel FilterPositionsByMasks
#pragma kernel ClearCombinedDepth
#pragma kernel ConvertCombinedDepth
#pragma kernel WriteCombinedDepth

RWStructuredBuffer<uint> _ColourDiagnostic;

Texture2D<float4> _ColorTex;
SamplerState sampler_ColorTex;

RWTexture2D<int> DepthTexture; // WriteDepth kernel writes here

Texture2D<float> _DepthTex;
//Texture2D<float> _DA3DepthTex;

StructuredBuffer<float3> _Positions;

RWStructuredBuffer<float4> _FinalColor;
RWStructuredBuffer<float4> _AccumColor;
RWStructuredBuffer<uint> _Contribution;
RWStructuredBuffer<float> _BestCameraScore;

RWStructuredBuffer<float4> _DebugBuffer;

uint TextureWidth;
uint TextureHeight;

uint ColorTextureWidth;
uint ColorTextureHeight;

float4x4 _ViewProj;
float4x4 _WorldToCamera;

int _GaussianCount;

Texture2D<int> DepthIntTexture;
RWTexture2D<float> DepthFloatTexture;

//filtering

StructuredBuffer<float3> _FilterPositions;
StructuredBuffer<float4x4> _FilterViewProjs;
StructuredBuffer<float4x4> _FilterWorldToCameras;

Texture2DArray<float4> _FilterMaskTex;
Texture2DArray<float> _FilterDepthTex;

RWStructuredBuffer<uint> _FilterVisibility;

uint _FilterPointCount;
uint _FilterCameraCount;

uint _FilterMaskWidth;
uint _FilterMaskHeight;

uint _FilterMaskRadius;
uint _FilterRequiredVotes;

uint _FilterDepthWidth;
uint _FilterDepthHeight;

//combined depth map
StructuredBuffer<float3> _CombinedPositions;
StructuredBuffer<float4> _CombinedColors;

RWTexture2D<int> CombinedDepthTexture;

float4x4 _CombinedViewProj;
float4x4 _CombinedWorldToCamera;
float4x4 _CombinedLocalToWorld;

int _CombinedGaussianCount;
int _CombinedTextureWidth;
int _CombinedTextureHeight;

Texture2D<int> CombinedDepthIntTexture;

RWTexture2D<float> CombinedDepthFloatTexture;

